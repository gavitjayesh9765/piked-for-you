# Copy to .env and fill in. NEVER commit .env (spec §66).

ENVIRONMENT=development
DEBUG=true

# ---------------------------------------------------------------------------
# Supabase
#
# Dashboard -> Project Settings -> API  (URL, anon key, service_role key)
# Dashboard -> Project Settings -> API -> JWT Settings  (JWT secret)
# Dashboard -> Project Settings -> Database  (connection string)
#
# Local dev: `supabase start` prints all of these.
# ---------------------------------------------------------------------------
SUPABASE_URL=http://localhost:54321

# Safe to expose. RLS is what protects the data, not this key.
SUPABASE_ANON_KEY=

# ⚠ BYPASSES ROW LEVEL SECURITY ENTIRELY.
# Server-side only. Never in NEXT_PUBLIC_*, never in client code, never committed.
SUPABASE_SERVICE_ROLE_KEY=

# Used to verify incoming JWT signatures. Treat as a secret.
SUPABASE_JWT_SECRET=

SUPABASE_STORAGE_PRODUCT_BUCKET=product-media
SUPABASE_STORAGE_REVIEW_BUCKET=review-media
# Signed-URL lifetimes (seconds): product images are public content, review
# media is user-generated and gets a much shorter window.
SIGNED_URL_TTL_PRODUCT=604800
SIGNED_URL_TTL_REVIEW=3600

# ---------------------------------------------------------------------------
# Database — Supabase Postgres
# Use the POOLED connection string (port 6543) in serverless environments.
# ---------------------------------------------------------------------------
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:54322/postgres

# ---------------------------------------------------------------------------
# App
# ---------------------------------------------------------------------------
API_V1_PREFIX=/api/v1
CORS_ORIGINS=["http://localhost:3000"]

# ---------------------------------------------------------------------------
# Media limits (spec §29, §46)
# ---------------------------------------------------------------------------
MAX_REVIEW_VIDEO_SECONDS=30
MAX_IMAGE_BYTES=8388608
MAX_VIDEO_BYTES=52428800
MAX_REVIEW_IMAGES=6
MAX_REVIEW_VIDEOS=1

# ---------------------------------------------------------------------------
# Rate limiting (spec §46)
# ---------------------------------------------------------------------------
REDIS_URL=redis://localhost:6379/0
RATE_LIMIT_ANON=60/minute
RATE_LIMIT_AUTH=180/minute
RATE_LIMIT_WRITE=20/minute

# ---------------------------------------------------------------------------
# Caching (spec §48)
# ---------------------------------------------------------------------------
PUBLIC_CACHE_SECONDS=300

# ---------------------------------------------------------------------------
# Outbound mail  (app/core/mail.py, docs/10-newsletter-email.md)
#
# PROVIDER: Brevo, free plan — 300 emails/day, unlimited contacts, no card.
# Picked over Resend (3,000/month but only 100/day) because a newsletter is a
# burst, not a trickle: one weekly send to 500 confirmed subscribers is 500
# messages in a minute. Transactional and campaign sends share the same 300.
#
# THREE VALUES:
#   disabled  Accept the signup, store the row, send nothing. <- WE ARE HERE
#   console   Log the confirmation link instead of sending. Local dev only —
#             config.py refuses this in production, because those URLs are
#             single-use credentials and a log is not where they belong.
#   brevo     Send for real. Requires BREVO_API_KEY or the process refuses to
#             start (better than failing on the first person who subscribes).
#
# WHY `disabled` RIGHT NOW
# The list is being collected ahead of the first send. Everything downstream
# already handles that honestly rather than pretending: the signup form says
# "the newsletter hasn't started yet" instead of "check your inbox",
# `confirmation_sent_at` stays NULL so nobody is recorded as having been asked,
# and /admin/newsletter says on the screen why every row is unconfirmed.
#
# TO TURN IT ON
#   1. Verify the sending domain in Brevo (SPF + DKIM). Unverified senders go
#      to spam and burn the domain's reputation on the first send.
#   2. Create an API key: Brevo -> SMTP & API -> API keys.
#   3. Set BREVO_API_KEY, then MAIL_PROVIDER=brevo, and restart.
#      New signups get a confirmation from that moment. Everyone collected
#      before it is in /admin/newsletter under "Unconfirmed" with "Not asked
#      yet" — that is the backlog to mail, and it is knowable precisely because
#      confirmation_sent_at was never faked.
# ---------------------------------------------------------------------------
MAIL_PROVIDER=disabled
BREVO_API_KEY=
MAIL_FROM_EMAIL=hello@sortedchoice.com
MAIL_FROM_NAME=SortedChoice
MAIL_REPLY_TO=

# Where confirmation and unsubscribe links point. The FRONTEND, not this API —
# the API's own /confirm returns JSON, and a subscriber who lands on
# {"accepted":true} cannot tell that from a broken site.
SITE_URL=http://localhost:3000
