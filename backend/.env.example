# Copy to .env and fill in. NEVER commit .env (spec §66).

ENVIRONMENT=development
DEBUG=true

# ---------------------------------------------------------------------------
# Supabase
#
# Dashboard -> Project Settings -> API  (URL, anon key, service_role key)
# Dashboard -> Project Settings -> API -> JWT Settings  (JWT secret)
# Dashboard -> Project Settings -> Database  (connection string)
#
# Local dev: `supabase start` prints all of these.
# ---------------------------------------------------------------------------
SUPABASE_URL=http://localhost:54321

# Safe to expose. RLS is what protects the data, not this key.
SUPABASE_ANON_KEY=

# ⚠ BYPASSES ROW LEVEL SECURITY ENTIRELY.
# Server-side only. Never in NEXT_PUBLIC_*, never in client code, never committed.
SUPABASE_SERVICE_ROLE_KEY=

# Used to verify incoming JWT signatures. Treat as a secret.
SUPABASE_JWT_SECRET=

SUPABASE_STORAGE_PRODUCT_BUCKET=product-media
SUPABASE_STORAGE_REVIEW_BUCKET=review-media
# Signed-URL lifetimes (seconds): product images are public content, review
# media is user-generated and gets a much shorter window.
SIGNED_URL_TTL_PRODUCT=604800
SIGNED_URL_TTL_REVIEW=3600

# ---------------------------------------------------------------------------
# Database — Supabase Postgres
# Use the POOLED connection string (port 6543) in serverless environments.
# ---------------------------------------------------------------------------
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:54322/postgres

# ---------------------------------------------------------------------------
# App
# ---------------------------------------------------------------------------
API_V1_PREFIX=/api/v1
CORS_ORIGINS=["http://localhost:3000"]

# ---------------------------------------------------------------------------
# Media limits (spec §29, §46)
# ---------------------------------------------------------------------------
MAX_REVIEW_VIDEO_SECONDS=30
MAX_IMAGE_BYTES=8388608
MAX_VIDEO_BYTES=52428800
MAX_REVIEW_IMAGES=6
MAX_REVIEW_VIDEOS=1

# ---------------------------------------------------------------------------
# Rate limiting (spec §46)
# ---------------------------------------------------------------------------
REDIS_URL=redis://localhost:6379/0
RATE_LIMIT_ANON=60/minute
RATE_LIMIT_AUTH=180/minute
RATE_LIMIT_WRITE=20/minute

# ---------------------------------------------------------------------------
# Caching (spec §48)
# ---------------------------------------------------------------------------
PUBLIC_CACHE_SECONDS=300
