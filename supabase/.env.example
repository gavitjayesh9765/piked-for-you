# Local Supabase stack secrets. Copy to `supabase/.env` — that file is
# gitignored and the CLI loads it automatically, so `env(...)` in config.toml
# resolves from here.
#
# This file is for the LOCAL stack only. The hosted project's providers are
# configured in the Supabase dashboard; see docs/09-google-sign-in.md.

# --- Google sign-in (docs/09-google-sign-in.md) ---
#
# From Google Cloud Console → APIs & Services → Credentials → OAuth client ID
# (type: Web application). Fill these in, then flip
# `[auth.external.google] enabled` to true in config.toml — the CLI refuses to
# start an enabled provider with an empty client_id.
SUPABASE_AUTH_GOOGLE_CLIENT_ID=
SUPABASE_AUTH_GOOGLE_SECRET=
