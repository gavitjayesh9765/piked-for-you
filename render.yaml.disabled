# Render Blueprint — SortedChoice API.
#
# Infrastructure as code so the deploy is reproducible: create the service with
# Render Dashboard -> New -> Blueprint -> point at this repo.
#
# ---------------------------------------------------------------------------
# NATIVE PYTHON RUNTIME, NOT DOCKER
#
# The only thing that ever argued for a Dockerfile here was `python-magic`,
# which binds to libmagic — a SYSTEM library pip cannot install. It turned out
# to be declared in pyproject.toml and imported nowhere; media validation is
# done by decoding the file with Pillow (app/modules/admin/media.py), which is
# a stronger check than any header sniff. The dependency is gone, and with it
# the reason for Docker.
#
# Everything left resolves to a prebuilt manylinux wheel — Pillow, asyncpg,
# cryptography, uvloop, httptools — so there is no compiler step and nothing
# to install at the OS level.
#
# ---------------------------------------------------------------------------
# PLAN: `free` WHILE BUILDING, `starter` BEFORE LAUNCH
#
# Free is deliberate and temporary. It is fine right now — nobody is using the
# site, so a cold start costs you a minute of your own time and nothing else.
# It stops being fine the moment real users arrive.
#
# What Free costs you:
#   - SPIN-DOWN after 15 minutes idle, then ~1 minute to wake. A first-time
#     visitor sees a loading page for a minute, and leaves.
#   - 750 INSTANCE-HOURS/month, and Render's docs are explicit that
#     "spun-down services don't consume Free instance hours" — the tier only
#     adds up BECAUSE services sleep. A month is ~730 hours, so a keep-alive
#     ping spends ~730 of the 750 and leaves ~20 hours of headroom for the
#     whole month. Redeploys eat that, then the service is suspended until
#     the 1st. This is why the ping plan was abandoned; it is arithmetic.
#   - EPHEMERAL FILESYSTEM, wiped on every restart. Harmless here only
#     because uploads go to Supabase Storage — keep it that way.
#   - Price-scrape BackgroundTasks DIE if the instance spins down mid-run.
#     Do not kick off a long scrape and walk away while on Free.
#
# Switching later is one line plus a redeploy. Set a reminder.
#
# REGION: Render has no India region (Oregon, Ohio, Virginia, Frankfurt,
# Singapore). Singapore is closest to Supabase ap-south-1 at ~55-75ms. If
# Render rejects `singapore` on Free, do NOT quietly accept Oregon — that is
# ~230ms to the database on every server-rendered request, which undoes the
# reason the frontend is pinned to bom1. Move to Starter instead.
# ---------------------------------------------------------------------------

services:
  - type: web
    name: sortedchoice-api
    runtime: python
    rootDir: backend

    region: singapore
    # ⚠ FLIP THIS TO `starter` BEFORE YOU LAUNCH. See the note above.
    plan: free

    buildCommand: pip install --upgrade pip && pip install .
    # ONE worker, deliberately. The price-scrape runs use FastAPI
    # BackgroundTasks (app/modules/admin/pricing.py) — in-process work that
    # outlives the response. Extra workers do not share that state, so scaling
    # out buys contention, not throughput. Scale the instance up, not out.
    # $PORT is injected by Render and must be bound, or the deploy is marked
    # unhealthy no matter how well the app started.
    # --forwarded-allow-ips='*' trusts X-Forwarded-* from any peer. That is
    # correct HERE and nowhere else: on Render the instance is reachable only
    # through Render's own proxy, whose address is not fixed or published, so
    # there is no narrower value to set. Two things keep it honest —
    #   * app/core/deps.py::client_ip is explicit that the resulting address is
    #     caller-controlled and is used for rate-limit keys and audit metadata
    #     ONLY, never for authorization;
    #   * nothing else can open a socket to this process.
    # If this service is ever exposed directly, or moved behind a proxy with a
    # known address, replace '*' with that address — a spoofed X-Forwarded-For
    # would otherwise let one caller consume another's rate-limit budget.
    startCommand: uvicorn app.main:app --host 0.0.0.0 --port $PORT --workers 1 --proxy-headers --forwarded-allow-ips='*'

    healthCheckPath: /health
    autoDeploy: true

    envVars:
      # pyproject requires >=3.11. Pinned rather than left to drift, so a
      # Render default bump cannot change the runtime under you mid-project.
      - key: PYTHON_VERSION
        value: "3.13.5"

      - key: ENVIRONMENT
        value: production
      - key: DEBUG
        value: "false"

      # --- Supabase. `sync: false` means Render prompts for the value on
      #     first deploy and never stores it in this file. ---
      - key: SUPABASE_URL
        sync: false
      - key: SUPABASE_ANON_KEY
        sync: false
      # BYPASSES ROW LEVEL SECURITY. Belongs here and nowhere else — never in
      # any NEXT_PUBLIC_ variable on the Vercel side.
      - key: SUPABASE_SERVICE_ROLE_KEY
        sync: false
      - key: SUPABASE_JWT_SECRET
        sync: false

      # --- Database ---
      # Use Supabase's SESSION pooler (port 5432), NOT the transaction pooler
      # (6543). app/db/session.py builds a SQLAlchemy pool and does not disable
      # prepared statements; asyncpg emits those, and pgbouncer in transaction
      # mode rejects them. The failure is intermittent and reads like a
      # database bug rather than a configuration one.
      - key: DATABASE_URL
        sync: false

      # A free instance running one worker does not need the 10+20 default,
      # and a Supabase free project does not have 30 connections to give.
      - key: DB_POOL_SIZE
        value: "5"
      - key: DB_MAX_OVERFLOW
        value: "5"

      # --- CORS. Must list the real frontend origin. A wrong value here fails
      #     only in the browser, which makes it look like a frontend bug. ---
      - key: CORS_ORIGINS
        sync: false

      - key: REQUIRE_ADMIN_MFA
        value: "true"

      # --- Rate limiting (app/core/limiter.py) ---
      # Deliberately EMPTY rather than absent. The setting defaults to
      # `redis://localhost:6379/0`, and there is no Redis on this instance —
      # so leaving it unset pointed the limiter at a socket that does not
      # exist. The limiter falls back to in-memory either way, but an empty
      # value says so on purpose instead of arriving via a failed connection.
      #
      # In-memory is a real limit at `--workers 1` (pinned above) and resets on
      # deploy. Add a Redis URL here the moment this scales past one worker, or
      # each worker will enforce the limits below independently.
      - key: REDIS_URL
        value: ""
      - key: RATE_LIMIT_ANON
        value: "60/minute"
      - key: RATE_LIMIT_AUTH
        value: "180/minute"
      - key: RATE_LIMIT_WRITE
        value: "20/minute"

      # --- Public site ---
      # Where the BROWSER lives, which is not where this API lives. Email
      # links must point at the frontend: /newsletter/confirm on this service
      # answers with JSON, so a subscriber who clicks a link to it gets a
      # brace on a white page and does not confirm. Set it to the Vercel
      # origin, no trailing slash (config.py strips one if you leave it).
      - key: SITE_URL
        sync: false

      # --- Email delivery (app/core/mail.py) ---
      #
      # ⚠ FLIP THIS TO `brevo` ONCE THE BREVO SETUP IN docs/10-newsletter-email.md
      #   IS DONE. `disabled` is the honest default for a first deploy: the
      #   service boots, signups are recorded, and nothing is sent — which is
      #   exactly what this codebase did before the transport existed.
      #
      # Do NOT set `console` here. config.py rejects it in production and the
      # deploy will fail to boot, deliberately: it writes single-use
      # confirmation links to the log, where they outlive the 24 hours they
      # are meant to be valid for.
      #
      # With `brevo`, BREVO_API_KEY must be set or the process refuses to
      # start. That is on purpose — the alternative is a service that looks
      # healthy and drops every confirmation mail.
      - key: MAIL_PROVIDER
        value: disabled
      - key: BREVO_API_KEY
        sync: false
      # Must be an address on a domain you have authenticated in Brevo
      # (SPF/DKIM). An unverified sender is rejected at the API, not silently
      # delivered to spam, so this fails loudly if it is wrong.
      - key: MAIL_FROM_EMAIL
        sync: false
      - key: MAIL_FROM_NAME
        value: SortedChoice

# ---------------------------------------------------------------------------
# DISABLED — renamed from render.yaml on 2026-08-23.
#
# Render only reads a file named exactly `render.yaml` at the repo root, so
# with this name nothing here syncs. Rename it back to re-enable.
#
# ⚠ THE RENAME ALONE DOES NOT STOP DEPLOYS. `autoDeploy` is a property of the
#   service once it has been created, not of this file — an existing service
#   keeps deploying on every push to main regardless of what this file is
#   called. To actually stop that: Render dashboard → the service → Settings →
#   Build & Deploy → Auto-Deploy → Off. Or suspend the service.
#
# Nothing in the newsletter work needs this file. MAIL_PROVIDER defaults to
# `disabled` in app/core/config.py, so a service that has never heard of these
# variables boots and sends nothing — the behaviour this codebase had before
# the mail transport existed. Set them in the dashboard when you turn Brevo
# on; docs/10-newsletter-email.md lists them.
# ---------------------------------------------------------------------------
